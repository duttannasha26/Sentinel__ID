{
  "name": "SyntheticDocument",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "passport",
        "visa",
        "national_id",
        "driving_license",
        "permit"
      ],
      "default": "passport"
    },
    "image_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "document_type",
    "image_url"
  ]
}